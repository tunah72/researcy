# Local development only. Copy to .env; never use these values in production.
APP_ENV=development
APP_ROLE=api
APP_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_LOOKUP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
IMPORT_QUOTA_LIMIT=10
# Processing bounds may be lowered, not raised beyond the approved M2 envelope.
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=15
JOB_STATEMENT_TIMEOUT_MS=5000
JOB_LOCK_TIMEOUT_MS=1000
WORKER_IDLE_MIN_SECONDS=1
WORKER_IDLE_MAX_SECONDS=5
WORKER_CLAIM_DEADLINE_SECONDS=1800
WORKER_IO_DEADLINE_SECONDS=30
WORKER_EMBEDDING_REQUEST_SECONDS=60
OLLAMA_BASE_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333
WORKER_BATCH_ROWS=500
PROCESSING_VALIDATING_DEADLINE_SECONDS=60
PROCESSING_PARSING_DEADLINE_SECONDS=60
PROCESSING_NORMALIZING_DEADLINE_SECONDS=120
PROCESSING_CHUNKING_DEADLINE_SECONDS=120
PROCESSING_EMBEDDING_DEADLINE_SECONDS=900
PROCESSING_INDEXING_DEADLINE_SECONDS=300
PARSER_CPU_SECONDS=45
PARSER_WALL_SECONDS=60
PARSER_MEMORY_BYTES=805306368
PARSER_OUTPUT_BYTES=134217728
PARSER_MAX_CHARACTERS=2000000
PARSER_MAX_CHUNKS=10000
API_PORT=8000
POSTGRES_DB=researcy
POSTGRES_USER=researcy
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://researcy:local-postgres-password@postgres:5432/researcy
MINIO_ROOT_USER=researcy-minio
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=researcy-originals
