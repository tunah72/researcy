# Local development only. Copy to .env; never use these values in production.
APP_ENV=development
APP_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_LOOKUP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
IMPORT_QUOTA_LIMIT=10
API_PORT=8000
POSTGRES_DB=researcy
POSTGRES_USER=researcy
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://researcy:local-postgres-password@postgres:5432/researcy
MINIO_ROOT_USER=researcy-minio
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=researcy-originals
